---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Pit two GitHub contribution histories against each other in Mona Mayhem."
		/>
		<title>Mona Mayhem — GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="arena-header">
				<p class="eyebrow">GitHub contribution battle arena</p>
				<h1>Mona Mayhem</h1>
				<p class="intro">Two players enter. The contribution count decides the champion.</p>
			</header>

			<form id="battle-form" class="battle-form">
				<div class="player-inputs">
					<div class="player-field">
						<label for="player-one">Player 1</label>
						<div class="input-wrap">
							<span aria-hidden="true">@</span>
							<input
								id="player-one"
								name="playerOne"
								type="text"
								autocomplete="off"
								placeholder="octocat"
								maxlength="39"
								pattern="[A-Za-z0-9]+(-[A-Za-z0-9]+)*"
								aria-describedby="username-hint"
								required
							/>
						</div>
					</div>

					<p class="versus" aria-hidden="true">VS</p>

					<div class="player-field">
						<label for="player-two">Player 2</label>
						<div class="input-wrap">
							<span aria-hidden="true">@</span>
							<input
								id="player-two"
								name="playerTwo"
								type="text"
								autocomplete="off"
								placeholder="your-rival"
								maxlength="39"
								pattern="[A-Za-z0-9]+(-[A-Za-z0-9]+)*"
								aria-describedby="username-hint"
								required
							/>
						</div>
					</div>
				</div>

				<p id="username-hint" class="hint">Enter a GitHub username (letters, numbers, and single hyphens).</p>
				<button class="battle-button" type="submit">Start the battle</button>
			</form>

			<p id="battle-status" class="battle-status" role="status" aria-live="polite"></p>

			<section id="battle-results" class="battle-results" aria-labelledby="results-heading" hidden>
				<h2 id="results-heading">Battle results</h2>
				<div class="matchup">
					<article class="score-card">
						<h3 id="player-one-name">Player 1</h3>
						<p class="score"><span id="player-one-score">—</span> <span class="score-label">contributions</span></p>
						<p class="date-range" id="player-one-range"></p>
						<div class="graph-scroll">
							<div class="contribution-grid" id="player-one-grid"></div>
						</div>
					</article>
					<p class="result-versus" aria-label="versus">VS</p>
					<article class="score-card">
						<h3 id="player-two-name">Player 2</h3>
						<p class="score"><span id="player-two-score">—</span> <span class="score-label">contributions</span></p>
						<p class="date-range" id="player-two-range"></p>
						<div class="graph-scroll">
							<div class="contribution-grid" id="player-two-grid"></div>
						</div>
					</article>
				</div>
			</section>
		</main>
	</body>
</html>

<script>
	interface ContributionDay {
		weekday: number;
		count: number;
		level: number;
	}

	interface ContributionWeek {
		index: number;
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionsResponse {
		schema: string;
		generated_at: string;
		from: string;
		to: string;
		range_days: number;
		total_contributions: number;
		private_contributions_included: boolean;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	interface ApiError {
		error?: string;
	}

	const DEFAULT_COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const submitButton = document.querySelector<HTMLButtonElement>('.battle-button');
	const statusMessage = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#battle-results');
	const playerOneName = document.querySelector<HTMLElement>('#player-one-name');
	const playerTwoName = document.querySelector<HTMLElement>('#player-two-name');
	const playerOneScore = document.querySelector<HTMLElement>('#player-one-score');
	const playerTwoScore = document.querySelector<HTMLElement>('#player-two-score');
	const playerOneRange = document.querySelector<HTMLElement>('#player-one-range');
	const playerTwoRange = document.querySelector<HTMLElement>('#player-two-range');
	const playerOneGrid = document.querySelector<HTMLElement>('#player-one-grid');
	const playerTwoGrid = document.querySelector<HTMLElement>('#player-two-grid');

	if (
		!form ||
		!playerOneInput ||
		!playerTwoInput ||
		!submitButton ||
		!statusMessage ||
		!results ||
		!playerOneName ||
		!playerTwoName ||
		!playerOneScore ||
		!playerTwoScore ||
		!playerOneRange ||
		!playerTwoRange ||
		!playerOneGrid ||
		!playerTwoGrid
	) {
		throw new Error('Battle page is missing a required form or results element.');
	}

	function isContributionsResponse(data: unknown): data is ContributionsResponse {
		if (typeof data !== 'object' || data === null) {
			return false;
		}

		const candidate = data as Partial<ContributionsResponse>;
		return (
			typeof candidate.total_contributions === 'number' &&
			Number.isFinite(candidate.total_contributions) &&
			candidate.total_contributions >= 0 &&
			typeof candidate.from === 'string' &&
			typeof candidate.to === 'string' &&
			Array.isArray(candidate.weeks) &&
			Array.isArray(candidate.colors_full) &&
			candidate.colors_full.length >= DEFAULT_COLORS.length &&
			candidate.colors_full.every((color) => typeof color === 'string' && /^#[\da-f]{6}$/i.test(color)) &&
			candidate.weeks.every(
				(week) =>
					typeof week === 'object' &&
					week !== null &&
					typeof week.first_day === 'string' &&
					Array.isArray(week.contribution_days) &&
					week.contribution_days.every(
						(day) =>
							Number.isInteger(day.weekday) &&
							day.weekday >= 0 &&
							day.weekday <= 6 &&
							Number.isFinite(day.count) &&
							day.count >= 0 &&
							Number.isInteger(day.level) &&
							day.level >= 0 &&
							day.level < DEFAULT_COLORS.length,
					),
			)
		);
	}

	async function fetchContributions(username: string): Promise<ContributionsResponse> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		let data: unknown;

		try {
			data = await response.json();
		} catch {
			throw new Error('The server returned an invalid response. Please try again.');
		}

		if (!response.ok) {
			const message = typeof data === 'object' && data !== null && 'error' in data
				? (data as ApiError).error
				: undefined;
			throw new Error(message || `Could not load @${username} (HTTP ${response.status}).`);
		}

		if (!isContributionsResponse(data)) {
			throw new Error(`Contribution data for @${username} has an unexpected format.`);
		}

		return data as ContributionsResponse;
	}

	function renderContributionGrid(
		grid: HTMLElement,
		username: string,
		contributions: ContributionsResponse,
	): void {
		const colors = contributions.colors_full.every((color) => /^#[\da-f]{6}$/i.test(color))
			? contributions.colors_full
			: DEFAULT_COLORS;
		const cells: HTMLSpanElement[] = [];

		for (const week of contributions.weeks) {
			const firstDay = new Date(`${week.first_day}T00:00:00Z`);

			for (const day of week.contribution_days) {
				const cell = document.createElement('span');
				const date = new Date(firstDay);
				date.setUTCDate(date.getUTCDate() + day.weekday);
				const dateLabel = date.toLocaleDateString(undefined, {
					timeZone: 'UTC',
					year: 'numeric',
					month: 'short',
					day: 'numeric',
				});
				const countLabel = `${day.count} contribution${day.count === 1 ? '' : 's'}`;

				cell.className = 'contribution-day';
				cell.style.backgroundColor = colors[Math.min(Math.max(day.level, 0), colors.length - 1)];
				cell.title = `${countLabel} on ${dateLabel}`;
				cell.setAttribute('aria-label', cell.title);
				cells.push(cell);
			}
		}

		grid.replaceChildren(...cells);
		grid.setAttribute('role', 'img');
		grid.setAttribute(
			'aria-label',
			`${username}'s contribution graph from ${contributions.from} to ${contributions.to}`,
		);
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();

		const usernameOne = playerOneInput.value.trim();
		const usernameTwo = playerTwoInput.value.trim();

		if (!usernameOne || !usernameTwo) {
			statusMessage.textContent = 'Enter both GitHub usernames to start the battle.';
			(usernameOne ? playerTwoInput : playerOneInput).focus();
			return;
		}

		playerOneInput.value = usernameOne;
		playerTwoInput.value = usernameTwo;
		if (!form.reportValidity()) {
			statusMessage.textContent = 'Check the usernames and try again.';
			return;
		}

		const originalButtonText = submitButton.textContent;

		submitButton.disabled = true;
		submitButton.textContent = 'Loading…';
		form.setAttribute('aria-busy', 'true');
		results.hidden = true;
		playerOneGrid.replaceChildren();
		playerTwoGrid.replaceChildren();
		statusMessage.textContent = 'Fetching contribution data…';

		try {
			const [contributionsOne, contributionsTwo] = await Promise.all([
				fetchContributions(usernameOne),
				fetchContributions(usernameTwo),
			]);
			const totalOne = contributionsOne.total_contributions;
			const totalTwo = contributionsTwo.total_contributions;
			const numberFormat = new Intl.NumberFormat();

			playerOneName.textContent = `@${usernameOne}`;
			playerTwoName.textContent = `@${usernameTwo}`;
			playerOneScore.textContent = numberFormat.format(totalOne);
			playerTwoScore.textContent = numberFormat.format(totalTwo);
			playerOneRange.textContent = `${contributionsOne.from} – ${contributionsOne.to}`;
			playerTwoRange.textContent = `${contributionsTwo.from} – ${contributionsTwo.to}`;
			renderContributionGrid(playerOneGrid, usernameOne, contributionsOne);
			renderContributionGrid(playerTwoGrid, usernameTwo, contributionsTwo);
			results.hidden = false;

			if (totalOne === totalTwo) {
				statusMessage.textContent = "It's a tie! The rivals are evenly matched.";
			} else {
				const winner = totalOne > totalTwo ? usernameOne : usernameTwo;
				statusMessage.textContent = `@${winner} wins the battle!`;
			}
		} catch (error) {
			statusMessage.textContent =
				error instanceof Error ? error.message : 'The battle could not be completed. Please try again.';
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = originalButtonText;
			form.removeAttribute('aria-busy');
		}
	});
</script>

<style>
	:root {
		font-family: Arial, Helvetica, sans-serif;
		color: #f7f4ff;
		background: #171326;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
		padding: 48px 20px;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(117 73 202 / 24%), transparent 55%),
			#171326;
	}

	.arena {
		width: min(100%, 760px);
		margin: 0 auto;
	}

	.arena-header {
		margin-bottom: 36px;
		text-align: center;
	}

	.eyebrow,
	.hint,
	.score-label {
		color: #b7adc9;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		color: #ffe66d;
		font-size: clamp(2.4rem, 8vw, 4.5rem);
		line-height: 1.05;
		text-shadow: 4px 4px 0 #8e44ad;
	}

	.intro {
		max-width: 480px;
		margin: 20px auto 0;
		color: #d3ccdf;
		line-height: 1.6;
	}

	.battle-form,
	.battle-results {
		padding: clamp(20px, 5vw, 36px);
		border: 1px solid #49405e;
		border-radius: 16px;
		background: rgb(35 29 53 / 90%);
		box-shadow: 0 18px 50px rgb(0 0 0 / 22%);
	}

	.player-inputs {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: end;
		gap: 18px;
	}

	.matchup {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 16px;
	}

	.player-field label {
		display: block;
		margin-bottom: 10px;
		font-weight: 700;
	}

	.input-wrap {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 14px;
		border: 1px solid #655b7b;
		border-radius: 9px;
		background: #171326;
		color: #b7adc9;
	}

	.input-wrap:focus-within {
		border-color: #ffe66d;
		outline: 2px solid rgb(255 230 109 / 30%);
	}

	input {
		width: 100%;
		min-width: 0;
		padding: 14px 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #fff;
		font: inherit;
	}

	input::placeholder {
		color: #80768f;
	}

	.versus {
		margin: 0 0 14px;
		color: #ff6b8a;
		font-size: 0.85rem;
		font-weight: 900;
	}

	.hint {
		margin: 14px 0 20px;
		font-size: 0.85rem;
	}

	.battle-button {
		width: 100%;
		padding: 15px 20px;
		border: 0;
		border-radius: 9px;
		background: #ffe66d;
		color: #211a2d;
		font: inherit;
		font-weight: 800;
		cursor: pointer;
		transition: transform 120ms ease, background-color 120ms ease;
	}

	.battle-button:hover:not(:disabled) {
		transform: translateY(-2px);
		background: #fff09b;
	}

	.battle-button:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	.battle-button:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.battle-status {
		min-height: 1.5em;
		margin: 22px 0;
		color: #ffe66d;
		font-weight: 700;
		text-align: center;
	}

	.battle-results {
		margin-top: 20px;
	}

	.battle-results h2 {
		margin: 0 0 24px;
		font-size: 1.25rem;
		text-align: center;
	}

	.score-card {
		min-width: 0;
		padding: 20px 12px;
		border: 1px solid #49405e;
		border-radius: 12px;
		background: #171326;
		text-align: center;
	}

	.score-card h3 {
		overflow-wrap: anywhere;
		margin: 0;
		color: #d3ccdf;
		font-size: 1rem;
	}

	.score {
		margin: 14px 0 0;
		color: #ffe66d;
		font-weight: 900;
	}

	.score-label {
		display: block;
		margin-top: 4px;
		font-size: 0.8rem;
		font-weight: 400;
	}

	.date-range {
		margin: 10px 0 14px;
		color: #b7adc9;
		font-size: 0.75rem;
	}

	.graph-scroll {
		overflow-x: auto;
		padding: 2px 0 8px;
	}

	.contribution-grid {
		display: grid;
		width: max-content;
		grid-auto-columns: 9px;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 9px);
		gap: 3px;
	}

	.contribution-day {
		width: 9px;
		height: 9px;
		border-radius: 2px;
	}

	.result-versus {
		display: grid;
		width: 46px;
		height: 46px;
		place-items: center;
		border: 2px solid #ff6b8a;
		border-radius: 50%;
		background: #34203e;
		color: #ff9aaf;
		font-size: 0.8rem;
		font-weight: 900;
	}

	@media (max-width: 560px) {
		body {
			padding: 32px 16px;
		}

		.player-inputs {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.matchup {
			grid-template-columns: minmax(0, 1fr);
		}

		.result-versus {
			justify-self: center;
		}

		.versus {
			margin: 0;
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.battle-button {
			transition: none;
		}
	}
</style>
