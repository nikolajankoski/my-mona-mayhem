<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<meta
			name="description"
			content="Pit two GitHub contribution histories against each other in Mona Mayhem."
		/>
		<title>Mona Mayhem — GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="arena-header">
				<p class="eyebrow">GitHub contribution battle arena</p>
				<h1>Mona Mayhem</h1>
				<p class="intro">Two players enter. The contribution count decides the champion.</p>
			</header>

			<form id="battle-form" class="battle-form">
				<div class="player-inputs">
					<div class="player-field">
						<label for="player-one">Player 1</label>
						<div class="input-wrap">
							<span aria-hidden="true">@</span>
							<input
								id="player-one"
								name="playerOne"
								type="text"
								autocomplete="off"
								placeholder="octocat"
								maxlength="39"
								pattern="[A-Za-z0-9]+(-[A-Za-z0-9]+)*"
								aria-describedby="username-hint"
								required
							/>
						</div>
					</div>

					<p class="versus" aria-hidden="true">VS</p>

					<div class="player-field">
						<label for="player-two">Player 2</label>
						<div class="input-wrap">
							<span aria-hidden="true">@</span>
							<input
								id="player-two"
								name="playerTwo"
								type="text"
								autocomplete="off"
								placeholder="your-rival"
								maxlength="39"
								pattern="[A-Za-z0-9]+(-[A-Za-z0-9]+)*"
								aria-describedby="username-hint"
								required
							/>
						</div>
					</div>
				</div>

				<p id="username-hint" class="hint">Enter a GitHub username (letters, numbers, and single hyphens).</p>
				<button class="battle-button" type="submit">Start the battle</button>
			</form>

			<p id="battle-status" class="battle-status" role="status" aria-live="polite"></p>

			<section id="battle-results" class="battle-results" aria-labelledby="results-heading" hidden>
				<h2 id="results-heading">Battle results</h2>
				<div class="matchup">
					<article class="score-card">
						<h3 id="player-one-name">Player 1</h3>
						<p class="score"><span id="player-one-score">—</span> <span class="score-label">contributions</span></p>
						<p class="date-range" id="player-one-range"></p>
						<div class="graph-scroll">
							<div class="contribution-grid" id="player-one-grid"></div>
						</div>
					</article>
					<p class="result-versus" aria-label="versus">VS</p>
					<article class="score-card">
						<h3 id="player-two-name">Player 2</h3>
						<p class="score"><span id="player-two-score">—</span> <span class="score-label">contributions</span></p>
						<p class="date-range" id="player-two-range"></p>
						<div class="graph-scroll">
							<div class="contribution-grid" id="player-two-grid"></div>
						</div>
					</article>
				</div>
			</section>
		</main>
	</body>
</html>

<script>
	interface ContributionDay {
		weekday: number;
		count: number;
		level: number;
	}

	interface ContributionWeek {
		index: number;
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionsResponse {
		schema: string;
		generated_at: string;
		from: string;
		to: string;
		range_days: number;
		total_contributions: number;
		private_contributions_included: boolean;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	interface ApiError {
		error?: string;
	}

	const DEFAULT_COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const submitButton = document.querySelector<HTMLButtonElement>('.battle-button');
	const statusMessage = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#battle-results');
	const playerOneName = document.querySelector<HTMLElement>('#player-one-name');
	const playerTwoName = document.querySelector<HTMLElement>('#player-two-name');
	const playerOneScore = document.querySelector<HTMLElement>('#player-one-score');
	const playerTwoScore = document.querySelector<HTMLElement>('#player-two-score');
	const playerOneRange = document.querySelector<HTMLElement>('#player-one-range');
	const playerTwoRange = document.querySelector<HTMLElement>('#player-two-range');
	const playerOneGrid = document.querySelector<HTMLElement>('#player-one-grid');
	const playerTwoGrid = document.querySelector<HTMLElement>('#player-two-grid');

	if (
		!form ||
		!playerOneInput ||
		!playerTwoInput ||
		!submitButton ||
		!statusMessage ||
		!results ||
		!playerOneName ||
		!playerTwoName ||
		!playerOneScore ||
		!playerTwoScore ||
		!playerOneRange ||
		!playerTwoRange ||
		!playerOneGrid ||
		!playerTwoGrid
	) {
		throw new Error('Battle page is missing a required form or results element.');
	}

	function isContributionsResponse(data: unknown): data is ContributionsResponse {
		if (typeof data !== 'object' || data === null) {
			return false;
		}

		const candidate = data as Partial<ContributionsResponse>;
		return (
			typeof candidate.total_contributions === 'number' &&
			Number.isFinite(candidate.total_contributions) &&
			candidate.total_contributions >= 0 &&
			typeof candidate.from === 'string' &&
			typeof candidate.to === 'string' &&
			Array.isArray(candidate.weeks) &&
			Array.isArray(candidate.colors_full) &&
			candidate.colors_full.length >= DEFAULT_COLORS.length &&
			candidate.colors_full.every((color) => typeof color === 'string' && /^#[\da-f]{6}$/i.test(color)) &&
			candidate.weeks.every(
				(week) =>
					typeof week === 'object' &&
					week !== null &&
					typeof week.first_day === 'string' &&
					Array.isArray(week.contribution_days) &&
					week.contribution_days.every(
						(day) =>
							Number.isInteger(day.weekday) &&
							day.weekday >= 0 &&
							day.weekday <= 6 &&
							Number.isFinite(day.count) &&
							day.count >= 0 &&
							Number.isInteger(day.level) &&
							day.level >= 0 &&
							day.level < DEFAULT_COLORS.length,
					),
			)
		);
	}

	async function fetchContributions(username: string): Promise<ContributionsResponse> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		let data: unknown;

		try {
			data = await response.json();
		} catch {
			throw new Error('The server returned an invalid response. Please try again.');
		}

		if (!response.ok) {
			const message = typeof data === 'object' && data !== null && 'error' in data
				? (data as ApiError).error
				: undefined;
			throw new Error(message || `Could not load @${username} (HTTP ${response.status}).`);
		}

		if (!isContributionsResponse(data)) {
			throw new Error(`Contribution data for @${username} has an unexpected format.`);
		}

		return data as ContributionsResponse;
	}

	function renderContributionGrid(
		grid: HTMLElement,
		username: string,
		contributions: ContributionsResponse,
	): void {
		const colors = contributions.colors_full.every((color) => /^#[\da-f]{6}$/i.test(color))
			? contributions.colors_full
			: DEFAULT_COLORS;
		const cells: HTMLSpanElement[] = [];

		for (const week of contributions.weeks) {
			const firstDay = new Date(`${week.first_day}T00:00:00Z`);

			for (const day of week.contribution_days) {
				const cell = document.createElement('span');
				const date = new Date(firstDay);
				date.setUTCDate(date.getUTCDate() + day.weekday);
				const dateLabel = date.toLocaleDateString(undefined, {
					timeZone: 'UTC',
					year: 'numeric',
					month: 'short',
					day: 'numeric',
				});
				const countLabel = `${day.count} contribution${day.count === 1 ? '' : 's'}`;

				cell.className = 'contribution-day';
				cell.style.backgroundColor = colors[Math.min(Math.max(day.level, 0), colors.length - 1)];
				cell.title = `${countLabel} on ${dateLabel}`;
				cell.setAttribute('aria-label', cell.title);
				cells.push(cell);
			}
		}

		grid.replaceChildren(...cells);
		grid.setAttribute('role', 'img');
		grid.setAttribute(
			'aria-label',
			`${username}'s contribution graph from ${contributions.from} to ${contributions.to}`,
		);
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();

		const usernameOne = playerOneInput.value.trim();
		const usernameTwo = playerTwoInput.value.trim();

		if (!usernameOne || !usernameTwo) {
			statusMessage.textContent = 'Enter both GitHub usernames to start the battle.';
			(usernameOne ? playerTwoInput : playerOneInput).focus();
			return;
		}

		playerOneInput.value = usernameOne;
		playerTwoInput.value = usernameTwo;
		if (!form.reportValidity()) {
			statusMessage.textContent = 'Check the usernames and try again.';
			return;
		}

		const originalButtonText = submitButton.textContent;

		submitButton.disabled = true;
		submitButton.textContent = 'Loading…';
		form.setAttribute('aria-busy', 'true');
		results.hidden = true;
		playerOneGrid.replaceChildren();
		playerTwoGrid.replaceChildren();
		statusMessage.textContent = 'Fetching contribution data…';

		try {
			const [contributionsOne, contributionsTwo] = await Promise.all([
				fetchContributions(usernameOne),
				fetchContributions(usernameTwo),
			]);
			const totalOne = contributionsOne.total_contributions;
			const totalTwo = contributionsTwo.total_contributions;
			const numberFormat = new Intl.NumberFormat();

			playerOneName.textContent = `@${usernameOne}`;
			playerTwoName.textContent = `@${usernameTwo}`;
			playerOneScore.textContent = numberFormat.format(totalOne);
			playerTwoScore.textContent = numberFormat.format(totalTwo);
			playerOneRange.textContent = `${contributionsOne.from} – ${contributionsOne.to}`;
			playerTwoRange.textContent = `${contributionsTwo.from} – ${contributionsTwo.to}`;
			renderContributionGrid(playerOneGrid, usernameOne, contributionsOne);
			renderContributionGrid(playerTwoGrid, usernameTwo, contributionsTwo);
			results.hidden = false;

			if (totalOne === totalTwo) {
				statusMessage.textContent = "It's a tie! The rivals are evenly matched.";
			} else {
				const winner = totalOne > totalTwo ? usernameOne : usernameTwo;
				statusMessage.textContent = `@${winner} wins the battle!`;
			}
		} catch (error) {
			statusMessage.textContent =
				error instanceof Error ? error.message : 'The battle could not be completed. Please try again.';
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = originalButtonText;
			form.removeAttribute('aria-busy');
		}
	});
</script>

<style>
	:root {
		--arcade-bg: #0a0a1a;
		--arcade-green: #5fed83;
		--arcade-purple: #8a2be2;
		--arcade-text: #e8e7f2;
		--arcade-muted: #a4a3b8;
		--arcade-panel: #111128;
		--arcade-border: #343455;
		font-family: Arial, Helvetica, sans-serif;
		color: var(--arcade-text);
		background: var(--arcade-bg);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
		padding: 48px 20px;
		position: relative;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(138 43 226 / 16%), transparent 58%),
			var(--arcade-bg);
	}

	body::before {
		position: fixed;
		z-index: 10;
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 2px,
			rgb(0 0 0 / 22%) 3px,
			rgb(0 0 0 / 22%) 4px
		);
		content: '';
		pointer-events: none;
	}

	.arena {
		position: relative;
		z-index: 1;
		width: min(100%, 760px);
		margin: 0 auto;
	}

	.arena-header {
		margin-bottom: 36px;
		text-align: center;
	}

	.eyebrow,
	.hint,
	.score-label {
		color: var(--arcade-muted);
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.55rem;
		line-height: 1.8;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: clamp(1.45rem, 6vw, 3.2rem);
		line-height: 1.55;
		text-shadow: 0 0 8px rgb(95 237 131 / 90%), 0 0 24px rgb(95 237 131 / 60%);
		animation: neon-pulse 3s ease-in-out infinite;
	}

	.intro {
		max-width: 480px;
		margin: 20px auto 0;
		color: var(--arcade-text);
		line-height: 1.6;
	}

	.battle-form,
	.battle-results {
		padding: clamp(20px, 5vw, 36px);
		border: 1px solid var(--arcade-border);
		border-radius: 8px;
		background: rgb(17 17 40 / 92%);
		box-shadow: 0 0 22px rgb(138 43 226 / 12%), 0 18px 50px rgb(0 0 0 / 35%);
	}

	.player-inputs {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: end;
		gap: 18px;
	}

	.matchup {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 16px;
	}

	.player-field label {
		display: block;
		margin-bottom: 10px;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.6rem;
		line-height: 1.8;
	}

	.player-field {
		animation: float-in 600ms ease-out both;
	}

	.player-field:nth-child(1) {
		animation-delay: 80ms;
	}

	.player-field:nth-child(3) {
		animation-delay: 180ms;
	}

	.input-wrap {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 14px;
		border: 1px solid #46466e;
		border-radius: 4px;
		background: var(--arcade-bg);
		color: var(--arcade-purple);
		box-shadow: inset 0 0 12px rgb(138 43 226 / 8%);
	}

	.input-wrap:focus-within {
		border-color: var(--arcade-green);
		outline: 2px solid rgb(95 237 131 / 24%);
		box-shadow: 0 0 14px rgb(95 237 131 / 24%);
	}

	input {
		width: 100%;
		min-width: 0;
		padding: 14px 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--arcade-text);
		font: inherit;
	}

	input::placeholder {
		color: #77778f;
	}

	.versus {
		padding: 8px 10px;
		margin: 0 0 14px;
		border: 1px solid transparent;
		border-radius: 4px;
		background: linear-gradient(var(--arcade-bg), var(--arcade-bg)) padding-box,
			linear-gradient(120deg, var(--arcade-green), var(--arcade-purple), var(--arcade-green)) border-box;
		background-size: auto, 200% 200%;
		color: var(--arcade-text);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.65rem;
		animation: gradient-shift 3s ease infinite;
		text-shadow: 0 0 8px var(--arcade-purple);
	}

	.hint {
		margin: 14px 0 20px;
		font-size: 0.85rem;
	}

	.battle-button {
		width: 100%;
		padding: 15px 20px;
		border: 1px solid var(--arcade-green);
		border-radius: 4px;
		background: var(--arcade-green);
		color: var(--arcade-bg);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.7rem;
		line-height: 1.8;
		cursor: pointer;
		box-shadow: 0 0 16px rgb(95 237 131 / 28%);
		transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
	}

	.battle-button:hover:not(:disabled) {
		transform: translateY(-2px);
		background: #83f59d;
		box-shadow: 0 0 24px rgb(95 237 131 / 58%);
	}

	.battle-button:focus-visible {
		outline: 3px solid var(--arcade-purple);
		outline-offset: 3px;
	}

	.battle-button:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.battle-status {
		min-height: 1.5em;
		margin: 22px 0;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.6rem;
		font-weight: 700;
		line-height: 1.9;
		text-align: center;
	}

	.battle-form[aria-busy='true'] + .battle-status {
		animation: loading-colors 1s ease-in-out infinite alternate;
	}

	.battle-results {
		margin-top: 20px;
	}

	.battle-results h2 {
		margin: 0 0 24px;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.8rem;
		line-height: 1.8;
		text-align: center;
	}

	.score-card {
		min-width: 0;
		position: relative;
		overflow: hidden;
		padding: 20px 12px;
		border: 1px solid #3b3b62;
		border-radius: 6px;
		background: var(--arcade-bg);
		text-align: center;
	}

	.score-card > * {
		position: relative;
		z-index: 1;
	}

	#battle-results:not([hidden]) .score-card::after {
		position: absolute;
		z-index: 0;
		top: -60%;
		left: -80%;
		width: 48%;
		height: 220%;
		background: linear-gradient(
			100deg,
			transparent 0,
			rgb(95 237 131 / 4%) 28%,
			rgb(255 255 255 / 24%) 50%,
			rgb(138 43 226 / 10%) 68%,
			transparent 100%
		);
		content: '';
		pointer-events: none;
		transform: rotate(18deg);
		animation: card-shimmer 1.2s ease-out 120ms both;
	}

	#battle-results:not([hidden]) .score-card:nth-child(3)::after {
		animation-delay: 300ms;
	}

	.score-card h3 {
		overflow-wrap: anywhere;
		margin: 0;
		color: var(--arcade-purple);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.58rem;
		line-height: 1.8;
		text-shadow: 0 0 8px rgb(138 43 226 / 45%);
	}

	.score {
		margin: 14px 0 0;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.9rem;
		line-height: 1.8;
		text-shadow: 0 0 10px rgb(95 237 131 / 40%);
	}

	.score-label {
		display: block;
		margin-top: 4px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.75rem;
		font-weight: 400;
	}

	.date-range {
		margin: 10px 0 14px;
		color: var(--arcade-muted);
		font-size: 0.75rem;
	}

	.graph-scroll {
		overflow-x: auto;
		padding: 2px 0 8px;
	}

	.contribution-grid {
		display: grid;
		width: max-content;
		grid-auto-columns: 9px;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 9px);
		gap: 3px;
	}

	.contribution-day {
		width: 9px;
		height: 9px;
		border-radius: 2px;
		box-shadow: 0 0 0 transparent;
		transition: transform 120ms ease, box-shadow 120ms ease, filter 120ms ease;
	}

	.contribution-day:hover {
		z-index: 1;
		filter: brightness(1.3);
		box-shadow: 0 0 6px var(--arcade-green), 0 0 12px rgb(95 237 131 / 75%);
		transform: scale(1.45);
	}

	.result-versus {
		display: grid;
		position: relative;
		width: 46px;
		height: 46px;
		place-items: center;
		border: 2px solid transparent;
		border-radius: 50%;
		background: linear-gradient(var(--arcade-bg), var(--arcade-bg)) padding-box,
			linear-gradient(135deg, var(--arcade-green), var(--arcade-purple), var(--arcade-green)) border-box;
		background-size: auto, 200% 200%;
		color: var(--arcade-text);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.55rem;
		text-shadow: 0 0 8px var(--arcade-purple);
		animation: gradient-shift 3s ease infinite;
		box-shadow: 0 0 16px rgb(138 43 226 / 28%);
	}

	@keyframes neon-pulse {
		0%,
		100% {
			opacity: 1;
			text-shadow: 0 0 8px rgb(95 237 131 / 90%), 0 0 24px rgb(95 237 131 / 60%);
		}

		50% {
			opacity: 0.82;
			text-shadow: 0 0 3px rgb(95 237 131 / 65%), 0 0 12px rgb(95 237 131 / 38%);
		}
	}

	@keyframes gradient-shift {
		0%,
		100% {
			background-position: center, 0% 50%;
		}

		50% {
			background-position: center, 100% 50%;
		}
	}

	@keyframes card-shimmer {
		from {
			left: -80%;
		}

		to {
			left: 140%;
		}
	}

	@keyframes float-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes loading-colors {
		from {
			color: var(--arcade-green);
			text-shadow: 0 0 8px rgb(95 237 131 / 55%);
		}

		to {
			color: #bd7bff;
			text-shadow: 0 0 10px rgb(138 43 226 / 75%);
		}
	}

	@media (max-width: 560px) {
		body {
			padding: 32px 16px;
		}

		.player-inputs {
			grid-template-columns: 1fr;
			gap: 16px;
